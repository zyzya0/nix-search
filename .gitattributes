# Count only C sources as the project language.
*.c linguist-language=C
*.h linguist-language=C

# Generated build files must never affect language statistics.
*.o linguist-detectable=false
*.d linguist-detectable=false

# Auxiliary files are not source code.
Makefile linguist-detectable=false
*.md linguist-detectable=false
*.nix linguist-detectable=false
*.sh linguist-detectable=false
.gitignore linguist-detectable=false
.gitattributes linguist-detectable=false
LICENSE linguist-detectable=false
